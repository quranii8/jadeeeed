  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one saffron call to action per screen.",
      "html": "<a class=\"ds-btn ds-btn-primary\" href=\"#\">ابدأ القراءة</a>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 20px;font-weight:600;font-size:14px;border:1.5px solid transparent;border-radius:4px;text-decoration:none;font-family:\"Noto Kufi Arabic\",system-ui,sans-serif;transition:transform .25s cubic-bezier(.16,1,.3,1),background-color .2s,box-shadow .25s cubic-bezier(.16,1,.3,1),border-color .2s,color .2s;cursor:pointer}.ds-btn:active{transform:scale(.97)}.ds-btn:focus-visible{outline:2.5px solid #D99A1E;outline-offset:3px}.ds-btn-primary{background:var(--gold,#D99A1E);color:#0E1630;box-shadow:0 6px 16px -6px rgba(143,93,7,.55)}.ds-btn-primary:hover{background:var(--gold-light,#F0BE52);box-shadow:0 10px 22px -8px rgba(143,93,7,.6)}"
    },
    {
      "name": "Button on Glaze",
      "kind": "button",
      "refersTo": "button-on-glaze",
      "description": "Secondary action beside the primary on the cobalt field.",
      "html": "<div class=\"ds-field-demo\"><a class=\"ds-btn-glaze\" href=\"#\">استمع</a></div>",
      "css": ".ds-field-demo{background:#1B3A8C;padding:20px}.ds-btn-glaze{display:inline-flex;align-items:center;gap:8px;padding:12px 20px;font-weight:600;font-size:14px;border-radius:4px;border:1.5px solid #EEF1EC;background:#10275F;color:#F4F6FB;text-decoration:none;transition:transform .25s cubic-bezier(.16,1,.3,1)}.ds-btn-glaze:active{transform:scale(.97)}.ds-btn-glaze:focus-visible{outline:2.5px solid #D99A1E;outline-offset:3px}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Plaster-side secondary action.",
      "html": "<a class=\"ds-btn-outline\" href=\"#\">كل القصص</a>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;gap:8px;padding:12px 20px;font-weight:600;font-size:14px;border-radius:4px;border:1.5px solid var(--border,#CBD3CA);background:var(--surface,#F8FAF7);color:var(--text,#0E1630);text-decoration:none;transition:border-color .2s,color .2s,transform .25s}.ds-btn-outline:hover{border-color:var(--primary,#1B3A8C);color:var(--primary,#1B3A8C)}.ds-btn-outline:active{transform:scale(.97)}.ds-btn-outline:focus-visible{outline:2.5px solid #D99A1E;outline-offset:3px}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "input-search",
      "description": "The primary action under the rosette; saffron border on focus.",
      "html": "<div class=\"ds-search\"><input class=\"ds-search-input\" dir=\"rtl\" placeholder=\"ابحث عن سورة، آية، أو رقم...\"><svg class=\"ds-search-icon\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg></div>",
      "css": ".ds-search{position:relative;max-width:42rem}.ds-search-input{width:100%;padding:16px 56px 16px 20px;font-size:16px;border:2px solid var(--border,#CBD3CA);border-radius:4px;background:var(--surface,#F8FAF7);color:var(--text,#0E1630);box-shadow:0 6px 18px -6px rgba(14,22,48,.18),0 2px 4px rgba(14,22,48,.06);outline:none;transition:border-color .2s}.ds-search-input:focus,.ds-search-input:focus-visible{border-color:#D99A1E}.ds-search-input::placeholder{color:var(--text-soft,#5F6A80)}.ds-search-icon{position:absolute;right:20px;top:50%;transform:translateY(-50%);color:var(--text-muted,#46516A);pointer-events:none}"
    },
    {
      "name": "Header Navigation",
      "kind": "nav",
      "refersTo": "page-band",
      "description": "Cobalt field header with saffron underline on the current link, sealed by the tile strip.",
      "html": "<header class=\"ds-nav\" dir=\"rtl\"><div class=\"ds-nav-row\"><span class=\"ds-nav-brand\">منصة القرآن الكريم</span><nav><a class=\"ds-nav-link\" aria-current=\"page\" href=\"#\">الرئيسية</a><a class=\"ds-nav-link\" href=\"#\">السور</a><a class=\"ds-nav-link\" href=\"#\">التفاسير</a></nav></div><div class=\"ds-strip\"></div></header>",
      "css": ".ds-nav{background:#1B3A8C;color:#F4F6FB}.ds-nav-row{display:flex;align-items:center;gap:16px;padding:10px 16px}.ds-nav-brand{font-family:ReemKufi,\"Noto Kufi Arabic\",sans-serif;font-weight:700;font-size:18px}.ds-nav-link{color:#C3CEEB;padding:8px 12px;font-size:14px;font-weight:500;text-decoration:none;border-bottom:2px solid transparent;transition:color .2s,border-color .2s}.ds-nav-link:hover,.ds-nav-link[aria-current=\"page\"]{color:#fff;border-bottom-color:#D99A1E}.ds-nav-link:focus-visible{outline:2.5px solid #D99A1E;outline-offset:3px}.ds-strip{height:8px;background:repeating-linear-gradient(90deg,#D99A1E 0 8px,#EEF1EC 8px 16px,#0E6B5A 16px 24px,#EEF1EC 24px 32px,#B4472F 32px 40px,#EEF1EC 40px 48px,#1B3A8C 48px 56px,#EEF1EC 56px 64px)}"
    },
    {
      "name": "Wall Tile Run",
      "kind": "custom",
      "refersTo": "wall-tile",
      "description": "Signature: glazed section tiles set in 5px grout, glazed edge at rest, sheen sweep on press.",
      "html": "<div class=\"ds-wall\" dir=\"rtl\"><a class=\"ds-tile ds-glaze\" style=\"background-color:#1B3A8C;color:#F4F6FB\" href=\"#\"><span class=\"ds-count\">١١٤ سورة</span><span><b class=\"ds-tile-title\">المصحف</b><span class=\"ds-tile-desc\" style=\"color:#C9D5F0\">السور كاملة بالرسم العثماني</span></span></a><a class=\"ds-tile ds-glaze\" style=\"background-color:#D99A1E;color:#1A1204\" href=\"#\"><span class=\"ds-count\" style=\"border-color:rgba(26,18,4,.18)\">التفاسير</span><span><b class=\"ds-tile-title\">التفاسير</b><span class=\"ds-tile-desc\" style=\"color:#4A3205\">تفاسير معتمدة آية بآية</span></span></a><a class=\"ds-tile ds-glaze\" style=\"background-color:#0E6B5A;color:#F2F8F5\" href=\"#\"><span class=\"ds-count\">القرّاء</span><span><b class=\"ds-tile-title\">القرّاء</b><span class=\"ds-tile-desc\" style=\"color:#BFE3D8\">تلاوات متواصلة</span></span></a><a class=\"ds-tile ds-glaze\" style=\"background-color:#B4472F;color:#FBF1EE\" href=\"#\"><span class=\"ds-count\">٢٥ نبياً</span><span><b class=\"ds-tile-title\">قصص الأنبياء</b><span class=\"ds-tile-desc\" style=\"color:#F4CFC5\">فيلم لكل نبي</span></span></a></div>",
      "css": ".ds-wall{display:grid;grid-template-columns:repeat(2,1fr);gap:5px;padding:5px;background:var(--grout-wall,#CBD3CA)}.ds-tile{display:flex;flex-direction:column;justify-content:space-between;gap:12px;min-height:9.5rem;padding:16px;text-decoration:none;border-radius:0;background-image:linear-gradient(155deg,rgba(255,255,255,.16),rgba(255,255,255,0) 38%,rgba(0,0,0,.10));box-shadow:inset 0 1.5px 0 rgba(255,255,255,.28),inset 0 -3px 0 rgba(0,0,0,.16),inset 0 0 0 1px rgba(0,0,0,.06)}.ds-count{align-self:flex-end;font-size:11px;font-weight:600;padding:2px 8px;border:1px solid rgba(238,241,236,.22)}.ds-tile-title{display:block;font-family:ReemKufi,\"Noto Kufi Arabic\",sans-serif;font-weight:700;font-size:20px;line-height:1.25}.ds-tile-desc{display:block;margin-top:4px;font-size:12px}.ds-glaze{position:relative;overflow:hidden;isolation:isolate}.ds-glaze::after{content:\"\";position:absolute;inset:-40%;background:linear-gradient(115deg,transparent 42%,rgba(255,255,255,.28) 50%,transparent 58%);transform:translateX(-70%);transition:transform .9s cubic-bezier(.16,1,.3,1);pointer-events:none}.ds-glaze:hover::after,.ds-glaze:focus-visible::after,.ds-glaze:active::after{transform:translateX(70%)}.ds-tile:focus-visible{outline:2.5px solid #D99A1E;outline-offset:3px}@media (prefers-reduced-motion:reduce){.ds-glaze::after{transition:none}}"
    },
    {
      "name": "Plaster Tile",
      "kind": "card",
      "refersTo": "plaster-tile",
      "description": "Reading-side index tile (surahs, Asma Allah) in the same grout grid.",
      "html": "<div class=\"ds-wall-p\" dir=\"rtl\"><a class=\"ds-ptile\" href=\"#\"><span class=\"ds-pnum\">١</span><b>الفاتحة</b></a><a class=\"ds-ptile\" href=\"#\"><span class=\"ds-pnum\">٢</span><b>البقرة</b></a></div>",
      "css": ".ds-wall-p{display:grid;grid-template-columns:repeat(2,1fr);gap:5px;padding:5px;background:var(--grout-wall,#CBD3CA)}.ds-ptile{display:flex;align-items:center;gap:16px;padding:16px;text-decoration:none;color:var(--text,#0E1630);background-color:var(--surface,#F8FAF7);background-image:linear-gradient(155deg,rgba(255,255,255,.5),rgba(255,255,255,0) 40%);box-shadow:inset 0 1.5px 0 rgba(255,255,255,.6),inset 0 -3px 0 rgba(14,22,48,.07);transition:background-color .25s}.ds-ptile:hover{background-color:var(--primary-soft,#E3E9F6)}.ds-ptile:focus-visible{outline:2.5px solid #D99A1E;outline-offset:3px}.ds-pnum{width:40px;height:40px;display:grid;place-items:center;color:var(--primary,#1B3A8C);font-weight:800;clip-path:polygon(50% 0,64% 15%,85% 15%,85% 36%,100% 50%,85% 64%,85% 85%,64% 85%,50% 100%,36% 85%,15% 85%,15% 64%,0 50%,15% 36%,15% 15%,36% 15%);background:var(--primary-soft,#E3E9F6)}"
    },
    {
      "name": "Page Band",
      "kind": "custom",
